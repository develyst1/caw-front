{
  "name": "caw-front",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3500}",
    "dev:http": "CAW_API=http CAW_API_URL=${CAW_API_URL:-http://127.0.0.1:4500} next dev -p ${PORT:-3500}",
    "build": "next build",
    "start": "next start -p ${PORT:-3500}",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../caw-back/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.57.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "shadcn": "4.21.5",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
