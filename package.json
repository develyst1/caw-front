{
  "name": "caw-front",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3500}",
    "dev:http": "CAW_API=http CAW_API_URL=${CAW_API_URL:-http://127.0.0.1:4500} next dev -p ${PORT:-3500}",
    "build": "next build",
    "start": "next start -p ${PORT:-3500}",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../caw-back/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "antd": "6.6.5",
    "next": "16.3.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
